// Dawnfox — Nightfox light palette for Zellij.
// Palette from EdenEast/nightfox.nvim (dawnfox):
//   bg1 #faf4ed  bg0 #ebe5df  sel0 #d0d8d8  sel1 #b8cece
//   fg1 #575279  fg2 #625c87
//   red #b4637a  green #618774  yellow #ea9d34  blue #286983
//   magenta #907aa9  cyan #56949f  orange #d7827e  pink #d685af
//
// Selected rows keep dark text on sel1 so the highlight stays readable
// on this light background.
themes {
    dawnfox {
        text_unselected {
            base 87 82 121
            background 250 244 237
            emphasis_0 180 99 122
            emphasis_1 86 148 159
            emphasis_2 97 135 116
            emphasis_3 40 105 131
        }
        text_selected {
            base 87 82 121
            background 184 206 206
            emphasis_0 180 99 122
            emphasis_1 86 148 159
            emphasis_2 97 135 116
            emphasis_3 40 105 131
        }
        ribbon_selected {
            base 250 244 237
            background 97 135 116
            emphasis_0 234 157 52
            emphasis_1 180 99 122
            emphasis_2 184 206 206
            emphasis_3 40 105 131
        }
        ribbon_unselected {
            base 250 244 237
            background 40 105 131
            emphasis_0 184 206 206
            emphasis_1 87 82 121
            emphasis_2 86 148 159
            emphasis_3 214 133 175
        }
        table_title {
            base 97 135 116
            background 250 244 237
            emphasis_0 180 99 122
            emphasis_1 86 148 159
            emphasis_2 97 135 116
            emphasis_3 184 206 206
        }
        table_cell_selected {
            base 87 82 121
            background 184 206 206
            emphasis_0 180 99 122
            emphasis_1 86 148 159
            emphasis_2 97 135 116
            emphasis_3 234 157 52
        }
        table_cell_unselected {
            base 87 82 121
            background 250 244 237
            emphasis_0 180 99 122
            emphasis_1 86 148 159
            emphasis_2 97 135 116
            emphasis_3 234 157 52
        }
        list_selected {
            base 87 82 121
            background 184 206 206
            emphasis_0 180 99 122
            emphasis_1 86 148 159
            emphasis_2 97 135 116
            emphasis_3 234 157 52
        }
        list_unselected {
            base 87 82 121
            background 250 244 237
            emphasis_0 180 99 122
            emphasis_1 86 148 159
            emphasis_2 97 135 116
            emphasis_3 234 157 52
        }
        frame_unselected {
            base 224 216 206
            background 0
            emphasis_0 152 147 165
            emphasis_1 184 206 206
            emphasis_2 168 163 179
            emphasis_3 0
        }
        frame_selected {
            base 52 98 72
            background 0
            emphasis_0 180 99 122
            emphasis_1 86 148 159
            emphasis_2 184 206 206
            emphasis_3 152 147 165
        }
        frame_highlight {
            base 180 99 122
            background 0
            emphasis_0 40 105 131
            emphasis_1 180 99 122
            emphasis_2 215 130 126
            emphasis_3 234 157 52
        }
        exit_code_success {
            base 97 135 116
            background 0
            emphasis_0 86 148 159
            emphasis_1 250 244 237
            emphasis_2 184 206 206
            emphasis_3 40 105 131
        }
        exit_code_error {
            base 180 99 122
            background 0
            emphasis_0 234 157 52
            emphasis_1 250 244 237
            emphasis_2 215 130 126
            emphasis_3 144 122 169
        }
        multiplayer_user_colors {
            player_1 87 82 121
            player_2 40 105 131
            player_3 97 135 116
            player_4 234 157 52
            player_5 86 148 159
            player_6 180 99 122
            player_7 144 122 169
            player_8 215 130 126
            player_9 214 133 175
            player_10 98 92 135
        }
    }
}
