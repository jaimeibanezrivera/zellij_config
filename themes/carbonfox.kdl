        multiplayer_user_colors {
            player_1 120 169 255
            player_2 37 190 106
            player_3 238 83 150
            player_4 8 189 186
            player_5 51 177 255
            player_6 190 149 255
            player_7 255 126 182
            player_8 61 219 217
