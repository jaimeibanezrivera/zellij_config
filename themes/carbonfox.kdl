            emphasis_0 242 244 248
            emphasis_1 238 83 150
            emphasis_2 51 177 255
            emphasis_3 190 149 255
        }
        ribbon_unselected {
            base 242 244 248
            background 40 40 40
            emphasis_0 238 83 150
            emphasis_1 51 177 255
            emphasis_2 37 190 106
            emphasis_3 120 169 255
        }
        table_title {
            base 37 190 106
