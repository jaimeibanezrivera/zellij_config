// Carbonfox — Nightfox dark palette for Zellij.
// bg #161616, unfocused pane border sits just above that black.
themes {
    carbonfox {
        text_unselected {
            base 242 244 248
            background 22 22 22
            emphasis_0 238 83 150
            emphasis_1 51 177 255
            emphasis_2 37 190 106
            emphasis_3 120 169 255
        }
        text_selected {
            base 242 244 248
            background 42 42 42
            emphasis_0 238 83 150
