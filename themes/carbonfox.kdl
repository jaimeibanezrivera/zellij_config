            emphasis_1 82 82 83
            emphasis_2 42 42 42
            emphasis_3 0
        }
        frame_selected {
            base 37 190 106
            background 0
            emphasis_0 238 83 150
            emphasis_1 51 177 255
            emphasis_2 120 169 255
